// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  // Direct postgresql:// connection. Prisma Postgres injects this as
  // POSTGRES_URL; a plain Vercel Postgres / Neon injects it as DATABASE_URL.
  url      = env("POSTGRES_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  id             String   @id @default(cuid())
  shop           String   @unique
  enabled        Boolean  @default(true)

  // Appearance — consumed by the storefront popup via /apps/cod/config
  headerTitle      String @default("Cash on Delivery")
  buttonText       String @default("Cash on Delivery")
  buttonColor      String @default("#F97316")
  buttonTextColor  String @default("#FFFFFF")
  backgroundColor  String @default("#FFFFFF")
  submitButtonText String @default("COMPLETE ORDER")
  fullNameLabel    String @default("Enter Your Full Name")
  phoneLabel       String @default("Phone Number")
  emailLabel       String @default("Email (optional)")
  addressLabel     String @default("Full Address")
  formWidth        Int    @default(480)
  formMaxHeight    Int    @default(90)

  // OTP verification. Credentials never leave the server.
  otpEnabled           Boolean @default(false)
  otpSmsApiUrl         String  @default("")
  otpSmsMethod         String  @default("POST")
  otpSmsApiKey         String  @default("")
  otpSmsSenderId       String  @default("")
  otpSmsParamsTemplate String  @default("")
  otpMessageTemplate   String  @default("Your verification code is {code}")

  // Online payment. When on, the popup offers Partial (advance) or Full
  // payment; the shopper is redirected to Shopify's hosted invoice to pay,
  // and any remainder is Cash on Delivery.
  partialEnabled Boolean @default(false)
  partialType    String  @default("percent")
  partialValue   Float   @default(25)
  partialNote    String  @default("")

  // bKash as an extra payment method (shopper sends money to this number and
  // enters the Transaction ID; verified manually for now).
  bkashEnabled        Boolean @default(false)
  bkashMerchantNumber String  @default("")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OtpChallenge {
  id         String    @id @default(cuid())
  shop       String
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([shop, phone])
}

model Province {
  id          String   @id @default(cuid())
  shop        String
  countryCode String   @default("BD")
  name        String
  position    Int      @default(0)
  cities      City[]
  createdAt   DateTime @default(now())

  @@index([shop])
  @@index([shop, countryCode])
}

model City {
  id         String   @id @default(cuid())
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([provinceId])
}

model CodOrder {
  id              String   @id @default(cuid())
  shop            String
  orderId         String
  orderName       String
  customerName    String
  phone           String
  province        String?
  city             String?
  address         String
  zip             String?
  shippingMethod  String
  total           Float
  currency        String
  advanceAmount   Float?
  codBalance      Float?
  paymentMethod   String?
  paymentChoice   String?
  bkashTrxId      String?
  paymentStatus   String?
  createdAt       DateTime @default(now())

  @@index([shop])
  @@index([shop, orderId])
}
